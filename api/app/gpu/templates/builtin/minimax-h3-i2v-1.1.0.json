  "manifest": {
    "workflow_key": "minimax-h3-i2v",
    "model_id": "minimax-h3",
    "version": "1.1.0",
    "title": "MiniMax H3 图生视频（带声音）",
    "description": "以一张首帧图（可加尾帧图）生成带原生音频的短视频。8 步 Lightning LoRA；固定在 Colab L4 上运行。",
    "modality": "video",
    "executor": "comfyui",
    "compute_spec": {
      "variant": "VARIANT_GPU",
      "accelerator": "L4",
      "shape": "SHAPE_STANDARD"
    },
    "max_runtime_minutes": 45,
    "parameters": {
      "first_frame": {
        "type": "image",
        "label": "首帧图",
        "description": "会被拉伸到所选画面比例，请先裁成同样的比例。",
        "binding": {
          "node": "1",
          "input": "image"
        },
        "required": true
      },
      "last_frame": {
        "type": "image",
        "label": "尾帧图",
        "description": "可选。模型会让视频收尾在这张图上（居中裁切到画面比例）。",
        "binding": {
          "node": "2",
          "input": "image"
        },
        "required": false
      },
      "prompt": {
        "type": "string",
        "label": "提示词",
        "description": "描述镜头、动作和声音（Audio:）。",
        "binding": {
          "node": "20",
          "input": "prompt"
        },
        "required": true,
        "default": "Animate the reference image with gentle natural motion."
      },
      "width": {
        "type": "integer",
        "label": "宽",
        "description": "必须是 32 的倍数。",
        "binding": {
          "node": "20",
          "input": "width"
        },
        "default": 480,
        "min": 256,
        "max": 1088,
        "step": 32
      },
      "height": {
        "type": "integer",
        "label": "高",
        "description": "必须是 32 的倍数。",
        "binding": {
          "node": "20",
          "input": "height"
        },
        "default": 864,
        "min": 256,
        "max": 1088,
        "step": 32
      },
      "length": {
        "type": "integer",
        "label": "帧数（24 帧/秒）",
        "description": "124 帧约 5 秒，362 帧约 15 秒；会向上取到 17k+5。",
        "binding": {
          "node": "20",
          "input": "length"
        },
        "default": 124,
        "min": 22,
        "max": 362,
        "step": 17
      },
      "seed": {
        "type": "integer",
        "label": "随机种子",
        "description": "-1 表示每次随机。",
        "binding": {
          "node": "23",
          "input": "noise_seed"
        },
        "default": -1,
        "min": 0,
        "max": 4294967295,
        "advanced": true
      },
      "steps": {
        "type": "integer",
        "label": "步数",
        "description": "Lightning LoRA 针对 8 步调校。",
        "binding": {
          "node": "22",
          "input": "steps"
        },
        "default": 8,
        "min": 4,
        "max": 12,
        "advanced": true
      }
    },
