  "manifest": {
    "workflow_key": "minimax-h3-relay",
    "model_id": "minimax-h3",
    "version": "1.0.0",
    "title": "MiniMax H3 多段无缝长视频（Latent 接力）",
    "description": "基于 H3-Latent-Relay 潜空间直传与音画同裁，一次提交连跑多段（突破 15 秒上限）无缝拼成一条有声长视频。多段提示词用单独一行 --- 分隔，全片共用 1~3 张参考图锁人锁景；在 Colab L4 上运行。",
    "modality": "video",
    "executor": "comfyui",
    "compute_spec": {
      "variant": "VARIANT_GPU",
      "accelerator": "L4",
      "shape": "SHAPE_STANDARD"
    },
    "max_runtime_minutes": 120,
    "parameters": {
      "ref_1": {
        "type": "image",
        "label": "参考图 1（对应 <Picture 1>）",
        "description": "人物或场景主参考图（必填，全片各段共用）。",
        "binding": {
          "node": "1",
          "input": "image"
        },
        "required": true,
        "slot_group": "refs",
        "max_edge": 768
      },
      "ref_2": {
        "type": "image",
        "label": "参考图 2（对应 <Picture 2>）",
        "description": "可选第二张参考图（如第二位角色或服装）。",
        "binding": {
          "node": "2",
          "input": "image"
        },
        "required": false,
        "slot_group": "refs",
        "max_edge": 768
      },
      "ref_3": {
        "type": "image",
        "label": "参考图 3（对应 <Picture 3>）",
        "description": "可选第三张参考图（如场景环境参考）。",
        "binding": {
          "node": "3",
          "input": "image"
        },
        "required": false,
        "slot_group": "refs",
        "max_edge": 768
      },
      "mode": {
        "type": "enum",
        "label": "模式",
        "description": "8 步 v1.1（Shift 6/3）保五官与连续动作最稳；高质量 20 步不使用加速 LoRA。",
        "default": "fast8",
        "options": [
          {
            "value": "fast",
            "label": "快速 4步"
          },
          {
            "value": "fast8",
            "label": "快速 8步 v1.1"
          },
          {
            "value": "hq",
            "label": "高质量 20步"
          }
        ],
        "typical_minutes": {
          "fast": 13,
          "fast8": 16,
          "hq": 24
        },
        "variants": {
          "fast": {},
          "fast8": {
            "set": {
              "11": {
                "lora_name": "minimax_h3_ref2v_turbo_8step_v1.1_768p_comfyui_bf16.safetensors"
              },
              "15": {
                "shift_video": 6.0,
                "shift_audio": 3.0
              },
              "22": {
                "steps": 8
              }
            }
          },
          "hq": {
            "set": {
              "21": {
                "sampler_name": "res_multistep"
              },
              "22": {
                "model": [
                  "10",
                  0
                ],
                "steps": 20
              },
              "25": {
                "model": [
                  "10",
                  0
                ]
              }
            },
            "drop": [
              "15",
              "11"
            ]
          }
        },
        "choices": [
          "fast",
          "fast8",
          "hq"
        ]
      },
      "segments": {
        "type": "integer",
        "label": "连跑段数",
        "description": "一次提交连续跑几段并无缝拼成一条视频（填 N 时，提示词请用单独一行 --- 分成 N 段）。",
        "binding": {
          "node": "25",
          "input": "segments"
        },
        "default": 2,
        "min": 1,
        "max": 8,
        "step": 1
      },
      "length": {
        "type": "integer",
        "label": "每段帧数（24 帧/秒）",
        "description": "124 帧≈5秒，192 帧≈8秒，260 帧≈11秒，362 帧≈15秒（严格落在 5+17k 网格上）；第 2 段起自动裁掉重叠帧。",
        "binding": {
          "node": "25",
          "input": "length"
        },
        "default": 124,
        "min": 22,
        "max": 362,
        "step": 17
      },
      "video_vae": {
        "type": "enum",
        "label": "视频 VAE（画风解码）",
        "description": "二次元/漫剧推荐无缝 VAE；真人写实短剧建议切回官方原版 VAE。",
        "binding": {
          "node": "13",
          "input": "vae_name"
        },
        "default": "minimax_h3_video_vae_dully_seamless_v1_int8convrot.safetensors",
        "options": [
          {
            "value": "minimax_h3_video_vae_dully_seamless_v1_int8convrot.safetensors",
            "label": "二次元/CG 无缝 VAE（推荐）"
          },
          {
            "value": "minimax_h3_video_vae_int8_convrot.safetensors",
            "label": "官方原版 VAE（真人写实）"
          }
        ],
        "choices": [
          "minimax_h3_video_vae_dully_seamless_v1_int8convrot.safetensors",
          "minimax_h3_video_vae_int8_convrot.safetensors"
        ]
      },
      "prompts": {
        "type": "string",
        "label": "多段提示词（用 --- 分隔每段）",
        "description": "每段一块提示词，段间用单独一行 --- 分隔；用 <Picture 1>、<Picture 2> 引用参考图，每段建议一镜到底并写明 Audio:。",
        "binding": {
          "node": "25",
          "input": "prompts"
        },
        "required": true,
        "default": "<Picture 1> moves naturally with smooth camera motion in the scene. Audio: gentle ambient room tone.\n---\n<Picture 1> continues moving smoothly in the same space without camera cuts. Audio: continuous ambient room tone."
      },
      "width": {
        "type": "integer",
        "label": "宽",
        "description": "必须是 32 的倍数。",
        "binding": {
          "node": "25",
          "input": "width"
        },
        "default": 544,
        "min": 256,
        "max": 1088,
        "step": 32
      },
      "height": {
        "type": "integer",
        "label": "高",
        "description": "必须是 32 的倍数。",
        "binding": {
          "node": "25",
          "input": "height"
        },
        "default": 960,
        "min": 256,
        "max": 1088,
        "step": 32
      },
      "context_frames": {
        "type": "integer",
        "label": "重叠钉住帧数",
        "description": "从上一段尾部拷贝钉住多少帧过渡（默认 22 帧≈0.9 秒最稳，5+17k 网格）。",
        "binding": {
          "node": "25",
          "input": "context_frames"
        },
        "default": 22,
        "min": 5,
        "max": 124,
        "step": 17,
        "advanced": true
      },
      "settle_frames": {
        "type": "integer",
        "label": "接缝沉降裁剪（同机位 0 / 换镜 -1）",
        "description": "同机位一镜到底保持 0（最平滑）；跨段切机位可填 -1 自动退回段边界。",
        "binding": {
          "node": "25",
          "input": "settle_frames"
        },
        "default": 0,
        "min": -1,
        "max": 36,
        "step": 1,
        "advanced": true
      },
      "refs_mode": {
        "type": "enum",
        "label": "参考图续接策略",
        "description": "lock（默认）= 全片每段锁定同一组参考图；first_only = 仅首段喂参考图，后续段靠潜空间延续。",
        "binding": {
          "node": "25",
          "input": "refs_mode"
        },
        "default": "lock",
        "options": [
          {
            "value": "lock",
            "label": "全片锁定参考图（lock，推荐）"
          },
          {
            "value": "first_only",
            "label": "仅首段用参考图（first_only）"
          }
        ],
        "choices": [
          "lock",
          "first_only"
        ],
        "advanced": true
      },
      "ref_anchor_mode": {
        "type": "enum",
        "label": "潜空间外观锚",
        "description": "off（默认，配 lock）；first = 锚定首段；roll = 滚动锚定上一段（建议配 first_only）。",
        "binding": {
          "node": "25",
          "input": "ref_anchor_mode"
        },
        "default": "off",
        "options": [
          {
            "value": "off",
            "label": "关闭（off）"
          },
          {
            "value": "first",
            "label": "锚定首段（first）"
          },
          {
            "value": "roll",
            "label": "滚动锚定上段（roll）"
          }
        ],
        "choices": [
          "off",
          "first",
          "roll"
        ],
        "advanced": true
      },
      "seed": {
        "type": "integer",
        "label": "随机种子",
        "description": "-1 表示每次随机。",
        "binding": {
          "node": "25",
          "input": "seed"
        },
        "default": -1,
        "min": 0,
        "max": 4294967295,
        "advanced": true
      }
    },
